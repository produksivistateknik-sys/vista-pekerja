# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web push (opsional)
VITE_VAPID_PUBLIC_KEY=

# Cloudflare R2 - domain publik bucket (BUKAN secret, aman diketahui client).
# Baru punya nilai valid setelah "Public Access" diaktifkan di dashboard Cloudflare
# untuk bucket R2 (custom domain atau r2.dev subdomain). Sama seperti repo vista-teknik -
# kedua app pakai Supabase project & bucket R2 yang sama.
VITE_R2_PUBLIC_BASE_URL=

# Kredensial R2 asli (R2_ACCOUNT_ID/R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY/R2_BUCKET_NAME)
# TIDAK ADA di sini - disimpan sebagai Edge Function secret di project Supabase (lihat
# vista-teknik/supabase/functions/r2-storage), bukan di env app manapun.
